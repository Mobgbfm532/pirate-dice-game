{
  "name": "pirate-dice-game",
  "version": "1.0.0",
  "description": "2, 4, 24: a multiplayer tavern dice game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix client ci --include=dev && npm --prefix client run build:deploy",
    "test": "node --test \"test/*.test.js\"",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "dev:test-server": "node test/dev-server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
